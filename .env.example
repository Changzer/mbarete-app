# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Initial admin account, created automatically on first boot if it doesn't exist yet.
# This account owns the install's company.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# The company name shown as the tenant of this install.
COMPANY_NAME=Mbarete

# Deployment mode: "self-hosted" (default) or "saas".
#  - self-hosted: one company, auto-seeded on first boot from the ADMIN_* /
#    COMPANY_NAME vars above. No public signup. This is the NAS install.
#  - saas: companies are created by the public /signup flow instead; nothing
#    is seeded on boot. Signup is gated by SIGNUP_CODE below.
# DEPLOY_MODE=self-hosted

# The invite code a person must present at /signup to create a company. Only
# used when DEPLOY_MODE=saas. Leave unset to keep signup closed (a public
# server with no code set will not mint companies).
# SIGNUP_CODE=

# The ONE signed-in account allowed into the platform admin panel (tenant
# plans, seats, backup status). This is the only way to grant panel access —
# there is deliberately no UI for it. Leave unset and the panel stays closed
# for everyone, including on self-hosted installs.
# PLATFORM_ADMIN_EMAIL=

# Outbound email (password reset links, email verification). Generic SMTP —
# for Tencent Exmail / WeCom mail, SMTP_PASS is the CLIENT AUTHORIZATION CODE
# generated in the mailbox settings (设置 → 客户端 → enable IMAP/SMTP), NOT
# the mailbox login password. Leave unset and email features simply say they
# are unavailable; everything else works as before.
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=contacts@example.cn
# SMTP_PASS=
# SMTP_FROM="Mbarete <contacts@example.cn>"
# The public URL this server is reached at — used to build the links inside
# emails. On the NAS this is the LAN address, e.g. http://192.168.1.10:3000
# APP_ORIGIN=

# Which host interface the app's port 3000 binds to. The default (all
# interfaces) is right for the NAS, where people browse to nas-ip:3000 on
# the LAN. On an internet-facing server UNCOMMENT the line below so the app
# answers only to the local reverse proxy (Caddy) and never the open
# internet — then confirm with: curl -m 5 http://<server-ip>:3000 (must fail).
# APP_PORT_BIND=127.0.0.1:3000:3000

# Password for the bundled Postgres database. The database is only reachable
# on the compose-internal network; set a strong value all the same.
DB_PASSWORD=change-me-too

# Uptime monitoring — a dead-man's switch that works from behind NAT (the
# NAS): while the app is healthy (database answering) it GETs this URL once
# a minute; when the pings STOP, the receiving service alerts you. Make a
# free check at https://healthchecks.io (or self-host Uptime Kuma with a
# push monitor) and paste its ping URL here. Unset = monitoring off.
# HEARTBEAT_URL=
# HEARTBEAT_INTERVAL_SECONDS=60

# Where first-sighting server-error emails go (requires SMTP_* above).
# Falls back to PLATFORM_ADMIN_EMAIL, then ADMIN_EMAIL. Alerts are hard
# throttled: one per distinct error per 6 hours, five total per hour.
# ALERT_EMAIL=

# Automated backups (docs/BACKUPS.md). A daily snapshot of the database and
# every uploaded file, kept for BACKUP_RETENTION copies. Docker defaults
# BACKUP_DIR to the mbarete-backups volume; point it at a bind mount on a
# DIFFERENT disk (or a NAS share) to survive the data disk failing. Unset
# BACKUP_DIR entirely to turn automated backups off.
# BACKUP_DIR=/app/backups
# BACKUP_RETENTION=14
# BACKUP_INTERVAL_HOURS=24

# Only needed for local (non-Docker) development: where Postgres is.
# Docker composes its own (see docker-compose.yml).
# DATABASE_URL=postgres://mbarete:mbarete@localhost:5432/mbarete

# Only used by the one-time SQLite import (npm run db:import-sqlite): where
# the old mbarete.db lives. Docker fixes this to /app/data.
# DATABASE_DIR=./data

# AI photo transcription ("Fill from photos" on products, "Fill from card" on
# contacts). Set at least one provider key; without any, the AI features are
# hidden and the forms work by hand. When both keys are set, Moonshot is used
# (force one with TRANSCRIBE_PROVIDER=moonshot or =anthropic).
#
# Moonshot/Kimi — recommended when this server runs in mainland China.
# Key from https://platform.moonshot.cn
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k2.6
# Thinking is disabled by default (measured ~4s per photo vs ~60s with it on).
# Set to 0 only for a model that rejects the thinking parameter.
# MOONSHOT_DISABLE_THINKING=1
#
# Anthropic/Claude — works anywhere with access to api.anthropic.com.
# Key from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# TRANSCRIBE_PROVIDER=

# Optional. Only affects build speed, not the running app. If npm downloads are
# slow on your network, point this at a closer mirror and rebuild. Example for
# mainland China:
# NPM_REGISTRY=https://registry.npmmirror.com
