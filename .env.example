# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Initial admin account, created automatically on first boot if it doesn't exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Only needed for local (non-Docker) development to control where the SQLite
# file and uploaded images are stored. Not needed in Docker (paths are fixed
# in docker-compose.yml).
# DATABASE_DIR=./data

# Optional. Only affects build speed, not the running app. If npm downloads are
# slow on your network, point this at a closer mirror and rebuild. Example for
# mainland China:
# NPM_REGISTRY=https://registry.npmmirror.com
