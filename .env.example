# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Initial admin account, created automatically on first boot if it doesn't exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Only needed for local (non-Docker) development to control where the SQLite
# file and uploaded images are stored. Not needed in Docker (paths are fixed
# in docker-compose.yml).
# DATABASE_DIR=./data

# Optional. Enables "Fill from photos" on the product form: market photos are
# sent to Claude to pre-fill the product details for proofreading. Leave unset
# to hide the feature entirely. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional, temporary. Only powers the /kimi-test diagnostic page, which
# evaluates Moonshot/Kimi as an alternative transcription backend from this
# server's own network. Key from https://platform.moonshot.cn
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-latest
# Set to 1 to ask the model to skip its reasoning step ("instant mode").
# Only some models accept this; if the test starts returning HTTP 400,
# remove this line.
# MOONSHOT_DISABLE_THINKING=1

# Optional. Only affects build speed, not the running app. If npm downloads are
# slow on your network, point this at a closer mirror and rebuild. Example for
# mainland China:
# NPM_REGISTRY=https://registry.npmmirror.com
