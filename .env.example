# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Initial admin account, created automatically on first boot if it doesn't exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Only needed for local (non-Docker) development to control where the SQLite
# file and uploaded images are stored. Not needed in Docker (paths are fixed
# in docker-compose.yml).
# DATABASE_DIR=./data

# AI photo transcription ("Fill from photos" on products, "Fill from card" on
# contacts). Set at least one provider key; without any, the AI features are
# hidden and the forms work by hand. When both keys are set, Moonshot is used
# (force one with TRANSCRIBE_PROVIDER=moonshot or =anthropic).
#
# Moonshot/Kimi — recommended when this server runs in mainland China.
# Key from https://platform.moonshot.cn
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k2.6
# Thinking is disabled by default (measured ~4s per photo vs ~60s with it on).
# Set to 0 only for a model that rejects the thinking parameter.
# MOONSHOT_DISABLE_THINKING=1
#
# Anthropic/Claude — works anywhere with access to api.anthropic.com.
# Key from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# TRANSCRIBE_PROVIDER=

# Optional. Only affects build speed, not the running app. If npm downloads are
# slow on your network, point this at a closer mirror and rebuild. Example for
# mainland China:
# NPM_REGISTRY=https://registry.npmmirror.com
